[Unit]
Description=GoClaw host-native Antigravity CLI bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/goclaw/agy-host.env
# Docker's host-gateway address keeps the bridge off public interfaces.
ExecStart=/usr/local/bin/goclaw-agy-host agy-host --listen 172.17.0.1:18891 --agy-path /root/.local/bin/agy --profiles-dir /var/lib/goclaw-agy/profiles
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
