[Unit]
Description=GoClaw host-native Antigravity CLI bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/goclaw/agy-host.env
# Set GOCLAW_AGY_HOST_LISTEN to the GoClaw compose network gateway, for example
# 172.18.0.1:18891. UFW must allow only that compose subnet to reach the port.
ExecStart=/usr/local/bin/goclaw-agy-host agy-host --listen ${GOCLAW_AGY_HOST_LISTEN} --agy-path /root/.local/bin/agy --profiles-dir /var/lib/goclaw-agy/profiles
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
